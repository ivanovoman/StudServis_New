# ============================================================
#  Поставщик моделей
# ============================================================
# Достаточно настроить ОДИН из вариантов ниже.
# Подробное сравнение — docs/LLM_PROVIDERS.md

# Какой поставщик основной: openrouter | gigachat | custom
# Для России рекомендуется gigachat: быстрее, не врёт в юридических
# ссылках и не вставляет иероглифы в русский текст (проверено прогоном).
LLM_PROVIDER=gigachat

# Запасной на случай, если у основного кончились лимиты (необязательно)
LLM_FALLBACK_PROVIDER=openrouter


# --- Вариант 1: OpenRouter ---------------------------------
# Ключ: https://openrouter.ai/keys
# Бесплатно: 50 запросов в сутки, 20 в минуту.
# Разовая покупка кредитов на $10 поднимает суточный лимит до 1000
# навсегда — сами кредиты на бесплатные модели не тратятся.
OPENROUTER_API_KEY=

# Список моделей через запятую, пробуются по порядку (необязательно)
# OPENROUTER_MODELS=minimax/minimax-m3:free,minimax/minimax-m2.7:free


# --- Вариант 2: GigaChat (Сбер) ----------------------------
# Работает из России без VPN и без иностранной карты.
# Физлицам дают 365 млн бесплатных токенов на год.
# Ключ: https://developers.sber.ru/studio → создать проект GigaChat API
#   → раздел «Настройки API» → кнопка «Получить ключ»
# Вставлять нужно Authorization Key (строка Base64 длиной ~100 символов),
# НЕ Client Secret. Если вставить Secret, придёт 401 «clientId is absent».
# Проверить ключ, не раскрывая его: npm run check:gigachat
GIGACHAT_AUTH_KEY=

# GIGACHAT_API_PERS — физлицо, GIGACHAT_API_B2B — юрлицо
# GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Модели по умолчанию: GigaChat-3-Ultra, -3-Pro, -2-Max, -2-Pro,
# -3-Lightning, -2 (пробуются по порядку)
# GIGACHAT_MODELS=GigaChat-3-Pro,GigaChat-2-Max

# Сервер Сбера подписан сертификатом Минцифры, которого нет в Node.
# Сертификат уже лежит в certs/russian_trusted_ca.pem и подключается
# сам при запуске через npm start — настраивать ничего не нужно.
#
# Аварийный вариант, если сертификат почему-то не подошёл: строка ниже
# отключает проверку TLS целиком. Локально приемлемо, в проде — нет.
# GIGACHAT_INSECURE_TLS=1

# Адрес API. По умолчанию новый api.giga.chat; старый хост Сбера
# gigachat.devices.sberbank.ru пока тоже отвечает.
# GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1/chat/completions


# --- Вариант 3: любой OpenAI-совместимый сервер ------------
# Groq, Cerebras, Together, Mistral, локальная Ollama, LM Studio,
# российские агрегаторы — всё, что говорит на диалекте OpenAI.
# CUSTOM_API_URL=https://api.groq.com/openai/v1/chat/completions
# CUSTOM_API_KEY=
# CUSTOM_MODELS=llama-3.3-70b-versatile

# Пример для локальной Ollama (ключ не нужен, интернет не нужен):
# CUSTOM_API_URL=http://127.0.0.1:11434/v1/chat/completions
# CUSTOM_MODELS=qwen2.5:14b


# ============================================================
#  Научные базы
# ============================================================

# Ключ OpenAlex — бесплатный, регистрация около минуты:
# openalex.org → аккаунт → openalex.org/settings/api
#
# Без ключа OpenAlex с февраля 2026 отдаёт лишь около сотни запросов в
# сутки на всех анонимов сразу, то есть почти всегда отвечает отказом.
# Сервис при этом работает: источники берутся из КиберЛенинки, просто
# зарубежных публикаций в выдаче не будет.
# OPENALEX_API_KEY=

# Адрес для «вежливого пула» OpenAlex. Свой указывать не обязательно.
# OPENALEX_EMAIL=dev@studservis.ru

# Crossref и DOAJ ключей не требуют. Crossref просит только почту — за
# неё пускает в «вежливый пул», который работает стабильнее анонимного.
# CROSSREF_EMAIL=dev@studservis.ru


# ============================================================
#  Прочее
# ============================================================

# Адрес Python-бэкенда (загрузка файлов, разбор темы, поиск источников)
# PY_BACKEND_URL=http://127.0.0.1:8000

# Публичный URL сервиса (для заголовка HTTP-Referer)
# PUBLIC_URL=http://localhost:3000

# Порт Node-сервера
# PORT=3000
