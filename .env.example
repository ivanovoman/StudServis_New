# Ключ OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Модель (опционально). Список бесплатных: https://openrouter.ai/models?max_price=0
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Публичный URL сервиса (для заголовка HTTP-Referer)
# PUBLIC_URL=http://localhost:3000

# Порт сервера (по умолчанию 3000)
# PORT=3000
