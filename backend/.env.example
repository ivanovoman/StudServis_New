# --- OpenRouter ---
# Получить: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Пусто = взять первую модель из app/modules/ai_engine/models.yaml
OPENROUTER_MODEL=

PUBLIC_URL=http://localhost:8000
DEBUG=false

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=studservis
POSTGRES_PASSWORD=studservis
POSTGRES_DB=studservis

# --- Qdrant (векторная база) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768

# --- Redis / Celery ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Безопасность ---
JWT_SECRET=CHANGE-ME-IN-PRODUCTION

# --- ЮKassa ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
